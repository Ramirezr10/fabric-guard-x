===============================
Phase 1: The "Hardware" Layer
===============================
> Building the foundation and virtualizing the "cables."

	# Create the Kubernetes cluster
	kind create cluster --config kind-config.yaml --name fabricguard-cluster

	# Create the dedicated Docker network for the Fabric
	docker network create fabric-net --subnet=192.168.50.0/24

	# Connect KinD nodes to the Fabric network (The "Hot-Plug")
	docker network connect fabric-net fabricguard-cluster-control-plane
	docker network connect fabric-net fabricguard-cluster-worker
	docker network connect fabric-net fabricguard-cluster-worker2

	# Verify node connectivity
	kubectl get nodes
	docker exec -it fabricguard-cluster-worker ip addr show

===============================
Phase 2: The "Plumbing" Layer
===============================
> Installing Multus CNI and configuring secondary interfaces.

	# Deploy Multus CNI
	kubectl apply -f https://raw.githubusercontent.com/k8snetworkplumbingwg/multus-cni/master/deployments/multus-daemonset.yml

	# Inject missing CNI binaries to all nodes
	for node in $(kind get nodes --name fabricguard-cluster); do
	    docker cp ./binaries/macvlan $node:/opt/cni/bin/
	done

	# Apply the Network Attachment Definition (NAD)
	kubectl apply -f k8s/fabric-conf.yaml

	# Deploy and verify the simulation pod
	kubectl apply -f k8s/dgx-sim-pod.yaml
	kubectl exec -it dgx-sim-pod -- ip addr show net1

===============================
Phase 3: The "Sentinel" Layer
===============================
> Containerizing and deploying the custom monitoring agent.

	# Build the Sentinel image (v5 for networking fixes, v6 for stress testing)
	docker build --platform linux/amd64 -t fabricguard-sentinel:v6 ./sentinel

	# Load the image into the KinD cluster
	kind load docker-image fabricguard-sentinel:v6 --name fabricguard-cluster

	# Deploy the Sentinel Pod and Service
	kubectl apply -f k8s/sentinel-pod.yaml
	kubectl apply -f k8s/sentinel-service.yaml

	# Verify the internal metrics endpoint
	kubectl exec -it fabricguard-sentinel -- curl localhost:8000/metrics

===============================
Phase 4: The "Chaos" Layer
===============================
> Injecting network failure and granting security permissions.

	# Check existing queuing disciplines
	kubectl exec -it fabricguard-sentinel -- tc qdisc show dev net1

	# Inject 25% packet loss (Requires CAP_NET_ADMIN)
	kubectl exec -it fabricguard-sentinel -- tc qdisc add dev net1 root netem drop 25%

	# Generate flood traffic to trigger drops
	kubectl exec -it fabricguard-sentinel -- ping -f -w 30 192.168.50.1

	# Clear the chaos (Reset the interface)
	kubectl exec -it fabricguard-sentinel -- tc qdisc del dev net1 root


====================================
Phase 5: The "Command Center" Layer
====================================
> Deploying the observability stack and debugging discovery.


	# Deploy Prometheus and Grafana
	kubectl apply -f k8s/prometheus-deployment.yaml
	kubectl apply -f k8s/grafana-deployment.yaml

	# Debug Service Discovery (The "None" Endpoint fix)
	kubectl get endpoints fabricguard-sentinel
	kubectl get pod fabricguard-sentinel --show-labels

	# Port-forwarding to access UI from macOS
	kubectl port-forward pod/prometheus 9090:9090 &
	kubectl port-forward pod/grafana 3000:3000 &

	# Final end-to-end check
	kubectl exec -it fabricguard-sentinel -- curl localhost:8000/metrics | grep drop